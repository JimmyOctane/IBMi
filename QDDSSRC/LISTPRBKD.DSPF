     A            POSPROD       15A  B  9 13COLOR(WHT) CHANGE(51)
     A            POSDESC       30A  B  9 29COLOR(WHT) CHANGE(52)
     A            POSSECT        3A  B  9 61COLOR(WHT) CHANGE(53)
     A            POSGRP         3A  B  9 66COLOR(WHT) CHANGE(54)
     A            POSCAT         3A  B  9 71COLOR(WHT) CHANGE(55)
     A*
